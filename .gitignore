node_modules/
.next/
.env*.local
*.tsbuildinfo
.DS_Store

# Artefactos intermedios de los lotes de contenido: los agentes devuelven JSON,
# el conversor emite el TypeScript y ESE es el que vale. Siete megas de pasos
# intermedios en la historia no le sirven a nadie y esconden el diff que sí
# importa. La biblioteca tipada es la fuente de verdad; el seed se genera de ahí.
.plan/

# Token de despliegue (Management API de Supabase). NO va en web/.env.local:
# Next.js carga ese archivo dentro del proceso del servidor web, y este token
# puede correr SQL arbitrario sobre toda la cuenta.
.env.deploy

# Paquetes de la PWA para el servidor propio (los escribe scripts/empaquetar-pwa.mjs).
# Un zip de ~70 MB por commit no va en la historia: se rearma con `npm run pwa:empaquetar`.
dist/
web/dist/

# Salida de Playwright: capturas, trazas y el informe HTML de cada corrida.
# Aparecen como sin confirmar despues de cualquier E2E y se colarian en un commit.
web/e2e/salida/
web/e2e/informe/
