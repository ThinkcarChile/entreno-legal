# Variables de STAGING. Nombres, nunca valores.
#
# Copia este archivo a `web/.env.staging` (que .gitignore ya excluye por el
# patrón .env*.local — verifícalo antes de escribir nada real) o exporta las
# variables en tu terminal antes de correr los E2E.
#
# NINGUNA de estas apunta jamás al proyecto de producción. `admin.ts` tiene una
# guarda que se niega a correr si E2E_SUPABASE_URL coincide con
# NEXT_PUBLIC_SUPABASE_URL, porque el limpiador de los E2E BORRA datos.

# --- Lo que necesita el bootstrap (scripts/staging-bootstrap.mjs) -----------

# El ref del proyecto de staging: los 20 caracteres de su URL de Supabase.
STAGING_PROJECT_REF=

# El token de la Management API. Vive en `.env.deploy` en la raíz del repo y el
# bootstrap lo lee de ahí; NO lo dupliques acá.
# SUPABASE_ACCESS_TOKEN=(en .env.deploy, no acá)

# --- Lo que necesitan los E2E (web/e2e/fixtures/contrato.ts) ---------------

# Dónde está la app de staging. SIN esta variable, Playwright salta todos los
# casos como NOT_RUN — nunca como PASS. Es la regla 1 del contrato.
E2E_BASE_URL=

# El proyecto de staging visto desde el navegador y desde Node.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=

# SOLO para preparar y limpiar, y SOLO desde `e2e/fixtures/admin.ts`. Nunca
# viaja al navegador ni aparece en un spec. Si aparece en un `page.evaluate`,
# está mal.
E2E_SUPABASE_SERVICE_ROLE_KEY=

# --- Los tres usuarios sintéticos ------------------------------------------
#
# A y B comparten hogar; AJENO vive en OTRO hogar, y es con quien se prueba que
# nadie ve la casa ajena. Los crea el bootstrap. Datos 100% inventados: ningún
# nombre, examen ni boleta real entra a staging.

E2E_USER_A_EMAIL=
E2E_USER_A_PASSWORD=

E2E_USER_B_EMAIL=
E2E_USER_B_PASSWORD=

E2E_USER_AJENO_EMAIL=
E2E_USER_AJENO_PASSWORD=
