{
  "name": "hagotufila-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "seed:geo": "node scripts/seed-geo.ts",
    "db:test": "bash scripts/db-test.sh",
    "db:contract": "bash scripts/check-db-contract.sh",
    "db:push:hosted": "node scripts/push-migrations-hosted.ts",
    "db:seed:hosted": "node scripts/seed-geo-hosted.ts",
    "verify:schema:hosted": "node scripts/verify-schema-hosted.ts",
    "verify:supabase": "node scripts/verify-supabase.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "verify:payments": "node --import ./scripts/loader/alias.mjs scripts/verify-payments.ts",
    "verify:execution": "node --import ./scripts/loader/alias.mjs scripts/verify-execution.ts",
    "verify:pwa": "node --import ./scripts/loader/alias.mjs scripts/verify-pwa.ts",
    "verify:transbank": "node --import ./scripts/loader/alias.mjs scripts/verify-transbank.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "transbank-sdk": "6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "3.2.7"
  }
}
