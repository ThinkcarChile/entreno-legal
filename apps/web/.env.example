# =============================================================================
# HagoTuFila — variables de entorno
# =============================================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas credenciales reales al repositorio: .env.local está ignorado.
#
# Sin credenciales de Supabase la aplicación arranca igual, en MODO
# DEMOSTRACIÓN: datos de ejemplo, solo lectura, sin cuentas. Es la forma más
# rápida de revisar la interfaz.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. URL de la aplicación                                          OBLIGATORIA
# -----------------------------------------------------------------------------
# Se usa en metadata, OpenGraph, sitemap, robots, en los enlaces de confirmación
# de correo y en la URL de retorno del pago. Sin barra final.
#
#   Local:      http://localhost:3000
#   Producción: https://hagotufila.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. Supabase                                    OBLIGATORIAS para usar de verdad
# -----------------------------------------------------------------------------
# Dónde encontrarlas: panel de Supabase → Project Settings → API Keys.
#
# Supabase reemplazó las claves `anon` y `service_role` por `publishable` y
# `secret`, y retira las antiguas a fines de 2026. La aplicación acepta ambas y
# prefiere las nuevas. En un proyecto creado hoy, usa las nuevas.

# URL del proyecto. Termina en .supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave PÚBLICA. Empieza por `sb_publishable_`.
# Viaja al navegador. Es segura de exponer: sus permisos son los de un visitante
# anónimo y RLS decide qué puede leer.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave PRIVADA. Empieza por `sb_secret_`.
# OMITE RLS: quien la tenga puede leer y escribir cualquier fila.
#   · Solo se lee desde código de servidor (`src/lib/supabase/admin.ts`).
#   · NUNCA le pongas el prefijo NEXT_PUBLIC_: Next la incrustaría en el
#     JavaScript que descarga el navegador.
#   · Si se filtra, rótala en el panel de inmediato.
# La necesita el registro de pagos y la conciliación. Sin ella, la aplicación
# funciona salvo confirmar un pago.
SUPABASE_SECRET_KEY=

# --- Claves heredadas (solo si tu proyecto todavía no migró) ------------------
# Si tu proyecto aún usa las claves antiguas, deja vacías las dos de arriba y
# completa estas. No definas ambas parejas a la vez.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# 3. Origen de datos                                                    OPCIONAL
# -----------------------------------------------------------------------------
# demo      → siempre datos de ejemplo, aunque haya credenciales
# supabase  → siempre datos reales; falla si faltan credenciales
# auto      → Supabase si hay credenciales, demostración si no (por defecto)
#
# Los dos modos NUNCA se mezclan: se decide una vez al arrancar y vale para toda
# la aplicación. En desarrollo se muestra un indicador para no confundirlos.
NEXT_PUBLIC_DATA_SOURCE=auto


# -----------------------------------------------------------------------------
# 4. Pagos                                                              OPCIONAL
# -----------------------------------------------------------------------------
# mock       → proveedor simulado. Recorre el mismo flujo que el real y deja el
#              pago confirmado. PROHIBIDO en producción: la aplicación se niega
#              a arrancar el pago si NODE_ENV=production y PAYMENT_PROVIDER=mock.
# transbank  → Webpay Plus. Todavía NO implementado: las llamadas lanzan un error
#              explícito hasta integrar el SDK oficial vigente.
PAYMENT_PROVIDER=mock

# integration | production. Mantener en integration hasta certificar el comercio.
TRANSBANK_ENVIRONMENT=integration

# Credenciales que entrega Transbank. Vacías mientras no se integre.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=


# -----------------------------------------------------------------------------
# 5. Parámetros de plataforma                                           OPCIONAL
# -----------------------------------------------------------------------------
# Comisión por defecto en puntos base: 1400 = 14 %.
# En modo Supabase manda `platform_settings.commission_bps`, que es lo que usa
# también la base al calcular el payout. Esto es solo el respaldo del modo
# demostración y la semilla inicial de esa tabla.
PLATFORM_COMMISSION_BPS=1400

# Plazo para abrir una disputa tras finalizar un trabajo, en horas.
DISPUTE_WINDOW_HOURS=12


# =============================================================================
# 6. Solo para las pruebas de integración y E2E                        OPCIONAL
# =============================================================================
# Las usan `npm run verify:supabase` y `npm run e2e`. No hacen falta para
# ejecutar la aplicación. Ver docs/DESPLIEGUE-SUPABASE.md.
#
# Cuentas de control de calidad. Créalas tú, con una contraseña que no uses en
# ningún otro sitio. El repositorio no trae credenciales.
E2E_CLIENT_EMAIL=
E2E_CLIENT_PASSWORD=
E2E_WORKER_EMAIL=
E2E_WORKER_PASSWORD=

# Un tercer usuario sin relación con los trabajos, para probar que no puede
# leer conversaciones ni datos ajenos.
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=

# Cuenta con rol de administración, para probar /admin y la verificación.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# URL contra la que corre Playwright. Por defecto http://localhost:3000
# E2E_BASE_URL=


# =============================================================================
# 7. Solo para aplicar migraciones a un proyecto alojado                OPCIONAL
# =============================================================================
# La aplicación NO lee estas variables. Las usa `npm run db:push:hosted`.
#
# La vía normal para desplegar el esquema es el CLI de Supabase:
#
#     npx supabase link --project-ref <ref>
#     npx supabase db push --include-seed
#
# que abre una conexión PostgreSQL directa (puerto 5432, o 6543 del pooler).
# Cuando ese puerto está cerrado —contenedores de integración continua, redes
# que solo dejan salir HTTPS— `db push` se queda esperando hasta agotar el
# tiempo. Para ese caso está `npm run db:push:hosted`, que aplica exactamente
# las mismas migraciones del repositorio a través de la Management API y lleva
# el mismo registro en `supabase_migrations.schema_migrations`.
#
# Token de acceso personal: https://supabase.com/dashboard/account/tokens
# Empieza por `sbp_`. Da acceso a TODOS tus proyectos: trátalo como una
# contraseña, no lo pegues en ningún archivo versionado.
SUPABASE_ACCESS_TOKEN=

# Referencia del proyecto. Si se omite, se deduce de NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_PROJECT_REF=
